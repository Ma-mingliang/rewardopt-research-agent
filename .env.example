# LLM API Configuration for research-agent
# Copy this file to .env and fill in your actual key

# API key for mimo-v2.5-pro via token-plan
MIMO_API_KEY=your_api_key_here

# Optional: override base URL (default: https://token-plan-sgp.xiaomimimo.com/v1)
# MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
